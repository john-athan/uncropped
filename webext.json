{
  "zip": "uncropped-{version}.zip",
  "ignore": ["await fetch\\(dataUrl\\)"],
  "urls": ["^https?://(www\\.)?w3\\.org", "^https?://(www\\.)?github\\.com/john-athan"],
  "versionIn": [{"file": "src/content.js", "pattern": "VERSION\\s*=\\s*'([^']+)'"}],
  "assets": {
    "screenshots/store-icon.png": [128, 128],
    "screenshots/store-1.png": [1280, 800],
    "screenshots/store-2.png": [1280, 800],
    "screenshots/store-3.png": [1280, 800],
    "screenshots/store-promo-small.png": [440, 280],
    "screenshots/store-promo-marquee.png": [1400, 560]
  },
  "storeIcon": "screenshots/store-icon.png",
  "render": {
    "icons": [
      {"from": "meta/icon-small.svg", "sizes": [16, 32]},
      {"from": "meta/icon.svg", "sizes": [48, 128]}
    ],
    "storeIcon": {"from": "meta/icon.svg", "inset": 16},
    "pages": [
      {"group": "promo", "from": "meta/promo-small.html", "to": "screenshots/store-promo-small.png", "size": [440, 280]},
      {"group": "promo", "from": "meta/promo-marquee.html", "to": "screenshots/store-promo-marquee.png", "size": [1400, 560]},
      {"group": "shots", "from": "meta/shot-1.html", "to": "screenshots/store-1.png", "size": [1280, 800]},
      {"group": "shots", "from": "meta/shot-2.html", "to": "screenshots/store-2.png", "size": [1280, 800]},
      {"group": "shots", "from": "meta/shot-3.html", "to": "screenshots/store-3.png", "size": [1280, 800]}
    ]
  },
  "justify": {
    "file": "meta/store-listing.md",
    "after": "## Permission justifications",
    "until": "\n## ",
    "name": "^\\*\\*([a-zA-Z]+)\\*\\*$",
    "extra": ["Remote"]
  }
}
